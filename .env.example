# Cerebro — Environment Variables
# Copy this file to .env and fill in values as needed.
# .env is gitignored — never commit secrets.

# Ollama endpoint (override default from settings.toml if needed)
# OLLAMA_BASE_URL=http://localhost:11434

# Logging level override (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Database path override
# CEREBRO_DB_PATH=~/.cerebro/db

# REST API port override
# CEREBRO_PORT=7842

# Disable proactive scheduler (set to "false" to turn off)
# CEREBRO_SCHEDULER_ENABLED=true

# ── llama.cpp inference backend ───────────────────────────────────────────────
# Switch primary inference engine: "ollama" (default) | "llamacpp"
# CEREBRO_INFERENCE_BACKEND=llamacpp

# llama-server address (started via: ./bin/start_engine.sh <profile>)
# CEREBRO_LLAMACPP_URL=http://127.0.0.1:8080

# GGUF model filename inside bin/models/ (default matches M1-8GB-friendly chat profile)
# CEREBRO_LLAMACPP_MODEL=Qwen2.5-Coder-3B-Instruct-Q4_K_M.gguf

# Single external llama-server (true, default) vs ModelManager multi-process swapping (false)
# CEREBRO_LLAMACPP_SIMPLE=true

# Proactive ContextEnricher (osascript); default off on low-RAM setups
# CEREBRO_PROACTIVE_CONTEXT=false

# MLX secondary / MLX-only: auto skips MLX when total RAM < 12 GB unless set to true
# CEREBRO_MLX_ENABLED=auto

# Startup profile: chat | coding | deep (args under config/*.args)
# CEREBRO_LLAMACPP_PROFILE=chat

# ── llama.cpp / Model Swapping ─────────────────────────────────────────────────
# Used when CEREBRO_INFERENCE_BACKEND=llamacpp.
# SmolLM2 runs on ROUTER_PORT (classification only); specialist loads on demand on SPECIALIST_PORT.
# CEREBRO_MODELS_DIR=cerebro/bin/models
# CEREBRO_ROUTER_MODEL=SmolLM2-135M-Instruct-Q4_K_M.gguf
# CEREBRO_GENERAL_MODEL=Llama-3.2-3B-Instruct-Q4_K_M.gguf
# CEREBRO_CODE_MODEL=Qwen_Qwen3-4B-Instruct-2507-Q4_K_M.gguf
# CEREBRO_ROUTER_PORT=8080
# CEREBRO_SPECIALIST_PORT=8081
# CEREBRO_ROUTER_CTX=1024
# CEREBRO_SPECIALIST_CTX=4096
# CEREBRO_SWAP_TIMEOUT=60
# CEREBRO_EMBED_MODEL=v5-nano-retrieval-Q4_K_M.gguf
# CEREBRO_EMBED_PORT=8082
# CEREBRO_EMBED_CTX=512

# ── Docker / Sandbox mode ─────────────────────────────────────────────────────
# Point to the llama.cpp service name inside Docker Compose.
# CEREBRO_LLAMACPP_URL=http://llamacpp:8080

# Directory where the built frontend lives (for serving via FastAPI).
# CEREBRO_FRONTEND_DIR=/app/ui/tray/dist

# Sandbox mode: disables macOS-specific features (Calendar, AppleScript, etc.)
# CEREBRO_MODE=sandbox
