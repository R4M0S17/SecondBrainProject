# Agent tool-loop responses (answer | tool). Tool names injected at runtime — see agent_grammar.py.
# JSON strings allow UTF-8 (Spanish diacritics) — do not restrict to ASCII.

root ::= answer-response | tool-response

answer-response ::= "{" ws "\"action\"" ws ":" ws "\"answer\"" ws "," ws "\"answer\"" ws ":" ws json-string ws "}" ws

tool-response ::= "{" ws "\"action\"" ws ":" ws "\"tool\"" ws "," ws "\"tool\"" ws ":" ws tool-name ws "," ws "\"args\"" ws ":" ws object ws "}" ws

# TOOL_NAME_RULE — replaced per agent authorized_tools list
tool-name ::= "placeholder" ws

json-string ::= "\"" char* "\"" ws
char ::= [^"\\\x00-\x09\x0B-\x1F] | "\\" escape
escape ::= ["\\/bfnrt] | "u" [0-9a-fA-F]{4}

value ::= object | array | json-string | number | ("true" | "false" | "null") ws

object ::=
  "{" ws (
    json-string ":" ws value
    ("," ws json-string ":" ws value)*
  )? "}" ws

array ::=
  "[" ws (
    value
    ("," ws value)*
  )? "]" ws

number ::= ("-"? ([0-9] | [1-9] [0-9]{0,15})) ("." [0-9]+)? ([eE] [-+]? [0-9] [1-9]{0,15})? ws

ws ::= ([ \t\n] ws)?
