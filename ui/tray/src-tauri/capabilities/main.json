{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Main window capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:7842/**" }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "restart-engine",
          "cmd": "/bin/bash",
          "args": [
            { "validator": "\\S+" }
          ]
        },
        {
          "name": "stop-engine",
          "cmd": "/bin/bash",
          "args": [
            { "validator": "\\S+" }
          ]
        },
        {
          "name": "open-in-browser",
          "cmd": "/usr/bin/open",
          "args": [
            { "validator": "https?://\\S+" }
          ]
        },
        {
          "name": "zsh",
          "cmd": "/bin/zsh",
          "args": [
            { "validator": "-c" },
            { "validator": ".*" }
          ]
        }
      ]
    },
    "dialog:default",
    "dialog:allow-open"
  ]
}
